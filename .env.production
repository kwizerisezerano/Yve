# ─── Application Secrets ─────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-jwt-secret-key-here-change-in-production
ENCRYPTION_KEY=your-encryption-key-here-32-chars-change-in-prod

# ─── Notify Email Provider Configuration ─────────────────────────────────────
# Generate with: openssl rand -base64 32
NOTIFY_APP_SECRET=your-notify-secret-key-here-change-in-production
NOTIFY_API_KEY=your-notify-api-key-here

# ─── Domain Configuration ──────────────────────────────────────────────────────
DOMAIN=yourdomain.com
