# ─── Database ────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ingoga_core
DB_USERNAME=postgres
DB_PASSWORD=postgres
DATABASE_URL="postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_DATABASE}"

# ─── Application ──────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=24h

# ─── Encryption ──────────────────────────────────────────────────────────────
# 32-character key for AES-256 encryption of API keys
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-super-secret-32-char-key!!

# ─── Redis (for api-key cache) ───────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── RabbitMQ (for async events — optional in early dev) ────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ─── Ingoga Core ──────────────────────────────────────────────────────────────
DEFAULT_CURRENCY=RWF

# ─── SMS Provider Microservice ───────────────────────────────────────────────
SMS_PROVIDER_URL=http://localhost:4000/send
SMS_PROVIDER_AUTH_TOKEN=ntf_6ef9d99fc6c892099e52003e03b384d578dd010e1c0e1efa

# ─── HDEV SMS Gateway (add HDEV_API_ID to use HDEV instead of default) ──────
HDEV_API_ID=your-hdev-api-id
HDEV_API_KEY=your-hdev-api-key
