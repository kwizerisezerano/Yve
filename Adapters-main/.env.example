DATABASE_URL="postgresql://user:password@localhost:5432/sms_adapter_db?schema=public"

# Shared secret required in the x-admin-key header for all /accounts admin routes.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=""

# Public base URL of this adapter, used to build the callback_url we hand to sms.to.
ADAPTER_BASE_URL="http://localhost:3000"

# sms.to (OPCO) API credentials.
OPCO_API_URL="https://api.sms.to"
OPCO_API_KEY=""
